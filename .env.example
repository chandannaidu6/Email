# URL of the private storage endpoint that receives entries.
STORAGE_ENDPOINT=
# Shared secret; must match the SECRET value configured on the storage endpoint.
STORAGE_SECRET=

# Must match RAFFLE_LINK_SECRET set on the study app's deployment. This is
# what proves a visitor arrived via a link minted by that app's
# completion page, rather than just guessing/sharing this page's URL.
RAFFLE_LINK_SECRET=
